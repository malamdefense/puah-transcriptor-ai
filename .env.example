# Copy this file to .env and customize. All variables start with PUAH_.

# --- Required for speaker diarization ---
# HuggingFace token (read). Required after accepting usage terms for:
#   https://huggingface.co/pyannote/speaker-diarization-3.1
#   https://huggingface.co/pyannote/segmentation-3.0
PUAH_HF_TOKEN=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

# --- Transcription model (ivrit.ai) ---
# Fast and accurate in Hebrew. For maximum accuracy: ivrit-ai/whisper-large-v3-ct2
PUAH_ASR_MODEL=ivrit-ai/whisper-large-v3-turbo-ct2
PUAH_LANGUAGE=he

# --- Hardware ---
# auto / cuda / cpu
PUAH_DEVICE=auto
# auto / float16 / int8 / int8_float16
PUAH_COMPUTE_TYPE=auto

# --- Automatic summary (local language model, OpenAI-compatible interface) ---
PUAH_SUMMARY_ENABLED=true
# Default: Ollama local. Alternatives: http://localhost:8000/v1 (vLLM), LM Studio etc.
PUAH_LLM_BASE_URL=http://localhost:11434/v1
# Default reliable: Gemma 4.0 12B it (multilingual, 256K context window). ollama pull gemma4:12b
PUAH_LLM_MODEL=gemma4:12b
# Hebrew-specific alternative: DictaLM 3.0. Pulling via hf.co fails currently (Ollama bug with HF),
# so we import it manually (see README) and set the name here, e.g.: dictalm3
PUAH_LLM_MODEL=dictalm3
PUAH_LLM_API_KEY=ollama
PUAH_LLM_TIMEOUT_SEC=600
# ollama (native /api/chat — controls num_ctx and disables reasoning) or "openai" (vLLM/LM Studio)
PUAH_LLM_PROVIDER=ollama
# Context window. The default of Ollama (4096) is too small for transcription — must increase.
PUAH_LLM_NUM_CTX=16384
PUAH_LLM_MAX_TOKENS=2048
# Disabling "thinking" of models like gemma4 — direct JSON output, faster. Enable only if the model requires it.
PUAH_LLM_THINK=false

# --- Word export + PII removal (after transcription is saved) ---
PUAH_WORD_EXPORT_ENABLED=true
# PII removal with HebSafeHarbor (installed in .venv-pii isolated)
PUAH_PII_ENABLED=true
PUAH_PII_VENV=.venv-pii
PUAH_PII_TIMEOUT_SEC=900

# --- General ---
PUAH_DATA_DIR=data
PUAH_MAX_UPLOAD_MB=2048
# Default hint for number of speakers (None = automatic diarization)
PUAH_DEFAULT_NUM_SPEAKERS=
# Preload models on startup (otherwise lazy on first task)
PUAH_PRELOAD_MODELS=true
