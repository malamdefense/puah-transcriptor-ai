# העתיקו קובץ זה ל-.env והתאימו. כל המשתנים בקידומת PUAH_.

# --- חובה לזיהוי דוברים ---
# טוקן HuggingFace (read). נדרש לאחר אישור תנאי השימוש של:
#   https://huggingface.co/pyannote/speaker-diarization-3.1
#   https://huggingface.co/pyannote/segmentation-3.0
PUAH_HF_TOKEN=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

# --- מודל תמלול (ivrit.ai) ---
# מהיר ומדויק בעברית. לדיוק מקסימלי: ivrit-ai/whisper-large-v3-ct2
PUAH_ASR_MODEL=ivrit-ai/whisper-large-v3-turbo-ct2
PUAH_LANGUAGE=he

# --- חומרה ---
# auto / cuda / cpu
PUAH_DEVICE=auto
# auto / float16 / int8 / int8_float16
PUAH_COMPUTE_TYPE=auto

# --- סיכום אוטומטי (מודל שפה מקומי, ממשק תואם OpenAI) ---
PUAH_SUMMARY_ENABLED=true
# ברירת מחדל: Ollama מקומי. חלופות: http://localhost:8000/v1 (vLLM), LM Studio וכו'.
PUAH_LLM_BASE_URL=http://localhost:11434/v1
# ברירת מחדל אמינה: Gemma 4.0 12B it (רב-לשוני, חלון 256K).  ollama pull gemma4:12b
PUAH_LLM_MODEL=gemma4:12b
# חלופה מותאמת-עברית: DictaLM 3.0. משיכה דרך hf.co נכשלת כיום (באג Ollama מול HF),
# לכן מייבאים ידנית (ראו README, "ייבוא DictaLM 3.0 ידני") ואז:  PUAH_LLM_MODEL=dictalm3
PUAH_LLM_API_KEY=ollama
PUAH_LLM_TIMEOUT_SEC=600
# ollama (native /api/chat — שולט בחלון ההקשר) או openai (vLLM/LM Studio)
PUAH_LLM_PROVIDER=ollama
# חלון הקשר — ה-default של Ollama (4096) קטן מדי לתמלול! חובה להגדיל.
PUAH_LLM_NUM_CTX=16384
PUAH_LLM_MAX_TOKENS=2048
# כיבוי "חשיבה" של gemma4 וכד' (פלט ישיר). הפעילו true רק אם המודל דורש זאת.
PUAH_LLM_THINK=false

# --- RAG סמנטי (הערכת איכות מול ground truth) ---
# מודל embedding רב-לשוני (עברית).  ollama pull bge-m3
PUAH_EMBED_MODEL=bge-m3

# --- ייצוא Word + הסרת PII (אחרי שמירת התמלול) ---
PUAH_WORD_EXPORT_ENABLED=true
# הסרת פרטים מזהים עם HebSafeHarbor (מותקן ב-.venv-pii מבודד)
PUAH_PII_ENABLED=true
PUAH_PII_VENV=.venv-pii
PUAH_PII_TIMEOUT_SEC=900

# --- כללי ---
PUAH_DATA_DIR=data
PUAH_MAX_UPLOAD_MB=2048
# רמז ברירת מחדל למספר דוברים (ריק = זיהוי אוטומטי)
PUAH_DEFAULT_NUM_SPEAKERS=
# טעינת המודלים מראש בעליית ה-worker
PUAH_PRELOAD_MODELS=true
