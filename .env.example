# Copy this file to .env and customize. All variables start with PUAH_.

# --- Required for speaker diarization ---
# HuggingFace token (read). Required after accepting the usage terms of:
#   https://huggingface.co/pyannote/speaker-diarization-3.1
#   https://huggingface.co/pyannote/segmentation-3.0
PUAH_HF_TOKEN=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

# --- Transcription model (ivrit.ai) ---
# Fast and accurate in Hebrew. For maximum accuracy: ivrit-ai/whisper-large-v3-ct2
PUAH_ASR_MODEL=ivrit-ai/whisper-large-v3-turbo-ct2
PUAH_LANGUAGE=he

# --- Hardware ---
# auto / cuda / cpu
PUAH_DEVICE=auto
# auto / float16 / int8 / int8_float16
PUAH_COMPUTE_TYPE=auto

# --- Automatic summary (Google Gemini — local model removed) ---
PUAH_SUMMARY_ENABLED=true
# Maximum output length. 2048 was too small (long summaries were truncated) — 6144 is slower but complete.
PUAH_LLM_MAX_TOKENS=6144

# --- Local Ollama server: currently used for embeddings only (RAG/evaluation) ---
# Ollama is required for the embedding model (bge-m3).
PUAH_LLM_BASE_URL=http://localhost:11434/v1
PUAH_LLM_TIMEOUT_SEC=600

# --- LLM provider: Google Gemini (cloud) ---
# Required: without a valid key, no summaries/feedback can be produced (no local path left).
# You can enter the key from the settings screen (⚙) in the UI — it overrides the value here.
# Key from https://aistudio.google.com/apikey
PUHA_GEMINI_API_KEY=
# gemini-1.5-flash/gemini-2.5-flash הוצאו משימוש ע"י Google. gemini-flash-latest
# is an alias that always points to the current flash model (up-to-date). For fixed recovery:
# קבועה: PUHA_GEMINI_MODEL=gemini-3.5-flash (גרסה קונקרטית שאומתה כעובדת)
PUHA_GEMINI_MODEL=gemini-flash-latest
# Thinking budget for Gemini (0=off, 1-=dynamic, or number of tokens). Default (0)
# Prevents truncation/truncation of the output when the internal "thinking" was not controlled.
PUHA_GEMINI_THINKING_BUDGET=0

# --- Semantic RAG (quality evaluation against ground truth) ---
# מודל embedding רב-לשוני (עברית).  ollama pull bge-m3
PUAH_EMBED_MODEL=bge-m3
# Vector storage: ChromaDB embedded (data/chroma/). Separate server — set host/port:
# PUAH_CHROMA_HOST=127.0.0.1
# PUAH_CHROMA_PORT=8000

# --- Word export + PII removal (after saving the transcription) ---
PUAH_WORD_EXPORT_ENABLED=true
# PII removal with HebSafeHarbor (installed in .venv-pii isolated)
PUAH_PII_ENABLED=true
PUAH_PII_VENV=.venv-pii
PUAH_PII_TIMEOUT_SEC=900

# --- General ---
PUAH_DATA_DIR=data
PUAH_MAX_UPLOAD_MB=2048
# Default hint for number of speakers (empty = automatic detection)
PUAH_DEFAULT_NUM_SPEAKERS=
# Preload models at startup by the worker
PUAH_PRELOAD_MODELS=true
