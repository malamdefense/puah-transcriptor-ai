[Unit]
Description=Puah transcription API + Web UI
After=network.target

[Service]
Type=simple
# התאימו את המשתמש והנתיב לשרת שלכם:
User=puah
WorkingDirectory=/opt/puah
Environment=PYTHONUTF8=1
Environment=PYTHONUNBUFFERED=1
# מאזין ל-localhost בלבד — חשיפה החוצה דרך reverse proxy (ראו deploy/nginx/puah.conf)
ExecStart=/opt/puah/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
