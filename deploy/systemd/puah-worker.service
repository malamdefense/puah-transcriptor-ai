[Unit]
Description=Puah transcription worker (GPU pipeline: transcribe, diarize, summarize, PII)
After=network.target ollama.service
Wants=ollama.service

[Service]
Type=simple
# התאימו את המשתמש והנתיב לשרת שלכם:
User=puah
WorkingDirectory=/opt/puah
Environment=PYTHONUTF8=1
Environment=PYTHONUNBUFFERED=1
Environment=HF_HUB_DISABLE_SYMLINKS_WARNING=1
# למצב מנותק-רשת (לאחר שהמודלים במטמון), הסירו את ההערה:
# Environment=HF_HUB_OFFLINE=1
# Environment=TRANSFORMERS_OFFLINE=1
ExecStart=/opt/puah/.venv/bin/python -m app.worker
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
